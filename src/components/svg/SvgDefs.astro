---
/**
 * Definiciones SVG compartidas.
 *
 * Formas de "papel recortado a mano" inspiradas en los trazos del patrón de
 * marca. Usan `clipPathUnits="objectBoundingBox"` (coordenadas 0–1), así que
 * se adaptan a cualquier tamaño con `clip-path: url(#cut-…)`.
 *
 * Se renderiza una sola vez en el layout.
 */
---

<svg class="svg-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <!-- Arco: puerta / ventana, para la foto principal del hero -->
    <clipPath id="cut-arch" clipPathUnits="objectBoundingBox">
      <path
        d="M0.04,0.985 L0.032,0.46 C0.03,0.19 0.24,0.018 0.5,0.02 C0.77,0.022 0.972,0.2 0.968,0.47 L0.962,0.975 C0.7,0.996 0.3,0.99 0.04,0.985 Z"
      ></path>
    </clipPath>

    <!-- Piedra: forma orgánica redondeada para retratos -->
    <clipPath id="cut-pebble" clipPathUnits="objectBoundingBox">
      <path
        d="M0.18,0.07 C0.38,-0.02 0.76,0.015 0.9,0.19 C1,0.34 0.985,0.68 0.87,0.85 C0.73,1 0.36,1 0.16,0.89 C0,0.77 -0.01,0.42 0.05,0.25 C0.08,0.16 0.12,0.11 0.18,0.07 Z"
      ></path>
    </clipPath>

    <!-- Boleto: rectángulo cortado a tijera, para tarjetas -->
    <clipPath id="cut-ticket" clipPathUnits="objectBoundingBox">
      <path
        d="M0.018,0.035 C0.26,0.012 0.62,0.03 0.978,0.012 C0.99,0.3 0.972,0.66 0.986,0.97 C0.7,0.99 0.34,0.974 0.022,0.988 C0.008,0.7 0.03,0.36 0.018,0.035 Z"
      ></path>
    </clipPath>

    <!-- Rasgado: bordes superior e inferior irregulares, para la galería -->
    <clipPath id="cut-torn" clipPathUnits="objectBoundingBox">
      <path
        d="M0,0.04 L0.07,0.015 L0.15,0.05 L0.24,0.02 L0.33,0.045 L0.42,0.01 L0.52,0.04 L0.61,0.018 L0.7,0.05 L0.8,0.02 L0.9,0.045 L1,0.015 L1,0.96 L0.92,0.985 L0.83,0.955 L0.73,0.99 L0.63,0.96 L0.53,0.99 L0.43,0.958 L0.33,0.985 L0.23,0.955 L0.13,0.99 L0.05,0.96 L0,0.985 Z"
      ></path>
    </clipPath>

    <!-- Insignia: medallón ondulado, para iconos de valores -->
    <clipPath id="cut-badge" clipPathUnits="objectBoundingBox">
      <path
        d="M0.5,0.02 C0.6,0.02 0.64,0.1 0.73,0.12 C0.83,0.14 0.9,0.12 0.94,0.22 C0.98,0.32 0.92,0.4 0.95,0.5 C0.98,0.6 1,0.68 0.94,0.78 C0.88,0.88 0.8,0.85 0.72,0.9 C0.64,0.96 0.6,0.99 0.5,0.99 C0.4,0.99 0.35,0.94 0.27,0.9 C0.18,0.86 0.1,0.88 0.06,0.78 C0.01,0.68 0.04,0.6 0.05,0.5 C0.06,0.4 0.01,0.32 0.06,0.22 C0.11,0.12 0.18,0.15 0.27,0.12 C0.36,0.09 0.4,0.02 0.5,0.02 Z"
      ></path>
    </clipPath>
  </defs>
</svg>

<style>
  .svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
