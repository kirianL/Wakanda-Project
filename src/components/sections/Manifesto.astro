---
/**
 * Sección 2: Por Qué Elegir Wakanda (Bento Grid Editorial).
 * Pulido siguiendo los principios de better-ui:
 * - Sin badges de píldora genéricos de IA: reemplazados por kickers tipográficos limpios.
 * - Sin cajas flotantes de estadísticas: integradas en filas de metadatos con divisores sutiles y números tabulares.
 * - Sin listas de checkmarks genéricas: narrativa editorial clara y jerarquía tipográfica precisa.
 * - Delineados de imagen según better-ui (1px puro con baja opacidad).
 */
import { Image } from 'astro:assets';
import photo6 from '@/assets/photos/6.jpg';
import photo12 from '@/assets/photos/12.jpg';
import photo10 from '@/assets/photos/10.jpg';
import photo1 from '@/assets/photos/1.jpg';
import TornEdge from '@/components/ui/TornEdge.astro';
---

<section id="proyecto" class="why-us" aria-labelledby="why-us-title">
  <div class="container why-us__container">
    <!-- Encabezado editorial equilibrado -->
    <div class="why-us__head" data-reveal>
      <span class="why-us__kicker">PROPUESTA PEDAGÓGICA · LIMÓN</span>
      <h2 id="why-us-title" class="why-us__title">
        Por qué elegir Wakanda
      </h2>
      <p class="why-us__subtitle">
        Un método que une técnica rigurosa, orgullo por nuestras raíces culturales y un entorno seguro donde cada estudiante crece con confianza.
      </p>
    </div>

    <!-- Cuadrícula Bento Editorial -->
    <div class="bento-grid">
      <!-- Tarjeta 1 (Bento Principal - Span 2 columnas) -->
      <article class="bento-card bento-card--lead" data-reveal>
        <div class="bento-card__lead-content">
          <h3 class="bento-card__title bento-card__title--light">
            Instructores con experiencia en formación infantil y ritmos afro
          </h3>
          <p class="bento-card__text bento-card__text--light">
            Acompañamiento cercano en cada etapa. Corregimos postura, ritmo y coordinación con paciencia, respeto cultural y cero presión.
          </p>

          <div class="bento-lead-meta">
            <div class="bento-meta-item">
              <span class="bento-meta-num">14</span>
              <span class="bento-meta-txt">Instructores con trayectoria artística</span>
            </div>
            <div class="bento-meta-item">
              <span class="bento-meta-num">4 a 15</span>
              <span class="bento-meta-txt">Años en tres grupos: Semillas, Raíces y Tribu</span>
            </div>
          </div>
        </div>
        <div class="bento-card__lead-visual">
          <Image
            src={photo6}
            alt="Instructores y bailarines en presentación escénica en Limón"
            class="bento-lead-img"
            widths={[400, 600]}
            sizes="(max-width: 768px) 90vw, 30vw"
            loading="lazy"
          />
        </div>
      </article>

      <!-- Tarjeta 2 (Espacio y Tarima - Span 1 columna) -->
      <article class="bento-card bento-card--light" data-reveal>
        <div class="bento-card__media">
          <Image
            src={photo12}
            alt="Salto en tarima de madera acondicionada para amortiguar el impacto"
            class="bento-card-img"
            widths={[380, 520]}
            sizes="(max-width: 768px) 90vw, 25vw"
            loading="lazy"
          />
        </div>
        <div class="bento-card__body">
          <h3 class="bento-card__title">Piso acondicionado para danza</h3>
          <p class="bento-card__text">
            Tarima de madera diseñada para amortiguar caídas y proteger las articulaciones y rodillas al bailar.
          </p>
        </div>
      </article>

      <!-- Tarjeta 3 (Escenario Real - Span 1 columna) -->
      <article class="bento-card bento-card--light" data-reveal>
        <div class="bento-card__media">
          <Image
            src={photo10}
            alt="Coreografía teatral con luces y maquillaje tradicional"
            class="bento-card-img"
            widths={[380, 520]}
            sizes="(max-width: 768px) 90vw, 25vw"
            loading="lazy"
          />
        </div>
        <div class="bento-card__body">
          <h3 class="bento-card__title">Muestras trimestrales con público</h3>
          <p class="bento-card__text">
            Presentaciones en teatros reales con vestuarios y luces, para que bailen con orgullo y seguridad frente a sus familias.
          </p>
        </div>
      </article>

      <!-- Tarjeta 4 (Horarios y Familias - Span 2 columnas) -->
      <article class="bento-card bento-card--accent" data-reveal>
        <div class="bento-card__lead-visual">
          <Image
            src={photo1}
            alt="Estudiante sonriendo con trenzas y corona tradicional"
            class="bento-lead-img"
            widths={[400, 600]}
            sizes="(max-width: 768px) 90vw, 30vw"
            loading="lazy"
          />
        </div>
        <div class="bento-card__lead-content">
          <h3 class="bento-card__title">
            Horarios claros y grupos organizados por edad
          </h3>
          <p class="bento-card__text">
            Clases pensadas para conciliar con la escuela sin estrés. Grupos reducidos para brindar atención personalizada y comunicación transparente y directa con los tutores.
          </p>

          <div class="bento-lead-meta bento-lead-meta--light">
            <div class="bento-meta-item">
              <span class="bento-meta-num">3:30 p.m.</span>
              <span class="bento-meta-txt">Turnos entre semana por la tarde</span>
            </div>
            <div class="bento-meta-item">
              <span class="bento-meta-num">8:30 a.m.</span>
              <span class="bento-meta-txt">Sábados durante la mañana</span>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>

  <!-- Borde rasgado inferior conectado con el ticker oscuro -->
  <TornEdge color="#080302" edge="bottom" shadow={true} />
</section>

<style>
  .why-us {
    position: relative;
    padding-block-start: clamp(5rem, 4rem + 4vw, 7.5rem);
    padding-block-end: clamp(6.5rem, 5rem + 5vw, 9.5rem);
    background: #ffffff;
    color: var(--earth-900);
  }

  .why-us__container {
    max-inline-size: 74rem;
    margin-inline: auto;
  }

  /* Encabezado */
  .why-us__head {
    max-inline-size: 46rem;
    margin-block-end: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .why-us__kicker {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--ochre-700);
    text-transform: uppercase;
    margin-block-end: 0.75rem;
  }

  .why-us__title {
    font-size: clamp(2.2rem, 1.8rem + 2.4vw, 3.75rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--earth-900);
    text-transform: uppercase;
    margin-block-end: 1rem;
  }

  .why-us__subtitle {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: oklch(0.36 0.085 56 / 0.82);
    line-height: 1.6;
    margin: 0;
  }

  /* Cuadrícula Bento */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 54rem) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Tarjetas Bento */
  .bento-card {
    border-radius: 1.5rem;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid oklch(0.26 0.06 56 / 0.1);
    box-shadow: 0 4px 20px -4px oklch(0.26 0.06 56 / 0.06);
    transition: box-shadow 260ms ease, border-color 260ms ease;
  }

  .bento-card:hover {
    box-shadow: 0 12px 32px -6px oklch(0.26 0.06 56 / 0.12);
    border-color: oklch(0.66 0.18 50 / 0.35);
  }

  /* Bento Lead (Tarjeta oscura) */
  .bento-card--lead {
    background: var(--earth-900);
    color: var(--cream-50);
    border-color: oklch(0.985 0.01 85 / 0.12);
  }

  @media (min-width: 54rem) {
    .bento-card--lead {
      grid-column: span 2;
      flex-direction: row;
      align-items: stretch;
    }
  }

  .bento-card__lead-content {
    flex: 1;
    padding: clamp(1.75rem, 1.5rem + 1.5vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .bento-card__lead-visual {
    flex: 0 0 42%;
    position: relative;
    min-height: 16rem;
    background: #190c05;
    overflow: hidden;
    outline: 1px solid oklch(1 0 0 / 0.1); /* Regla better-ui para imagen oscura */
    outline-offset: -1px;
  }

  .bento-lead-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  /* Bento Light (Tarjetas blancas) */
  .bento-card--light {
    background: #ffffff;
    color: var(--earth-900);
  }

  .bento-card__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f0e6d6;
    outline: 1px solid oklch(0 0 0 / 0.08); /* Regla better-ui para imagen clara */
    outline-offset: -1px;
  }

  .bento-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  .bento-card__body {
    padding: 1.5rem 1.65rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Bento Accent (Tarjeta complementaria crema / ocre) */
  .bento-card--accent {
    background: var(--cream-100);
    color: var(--earth-900);
    border-color: oklch(0.66 0.18 50 / 0.2);
  }

  @media (min-width: 54rem) {
    .bento-card--accent {
      grid-column: span 2;
      flex-direction: row-reverse;
      align-items: stretch;
    }
  }

  .bento-card__title {
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.45rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-block-end: 0.65rem;
  }

  .bento-card__title--light {
    color: #ffffff;
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.85rem);
    line-height: 1.2;
  }

  .bento-card__text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: oklch(0.36 0.085 56 / 0.85);
    margin: 0;
  }

  .bento-card__text--light {
    color: var(--cream-200);
  }

  /* Metadatos editoriales (reemplaza las cajas plásticas de IA) */
  .bento-lead-meta {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid oklch(1 0 0 / 0.12); /* Separador limpio en modo oscuro */
  }

  .bento-lead-meta--light {
    border-top: 1px solid oklch(0.26 0.06 56 / 0.14); /* Separador limpio en modo claro */
  }

  .bento-meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .bento-meta-num {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 0.5vw, 1.85rem);
    font-weight: 900;
    color: var(--sun-300);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .bento-lead-meta--light .bento-meta-num {
    color: var(--ochre-700);
  }

  .bento-meta-txt {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--cream-200);
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  .bento-lead-meta--light .bento-meta-txt {
    color: oklch(0.36 0.085 56 / 0.85);
  }
</style>
