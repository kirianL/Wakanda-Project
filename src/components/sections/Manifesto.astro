---
/**
 * Sección 2: Por Qué Elegir Wakanda (Bento Grid Moderno).
 * Reemplaza la baraja comprimida por una cuadrícula equilibrada y espaciosa,
 * con fotografías reales de alumnas y alumnos, textos legibles y tokens de marca.
 */
import { Image } from 'astro:assets';
import photo6 from '@/assets/photos/6.jpg';
import photo12 from '@/assets/photos/12.jpg';
import photo10 from '@/assets/photos/10.jpg';
import photo1 from '@/assets/photos/1.jpg';
import TornEdge from '@/components/ui/TornEdge.astro';
---

<section id="proyecto" class="why-us" aria-labelledby="why-us-title">
  <div class="container why-us__container">
    <!-- Encabezado editorial equilibrado -->
    <div class="why-us__head" data-reveal>
      <span class="why-us__kicker">PROPUESTA PEDAGÓGICA · LIMÓN</span>
      <h2 id="why-us-title" class="why-us__title">
        Por qué elegir Wakanda
      </h2>
      <p class="why-us__subtitle">
        Un método que combina técnica rigurosa, orgullo por nuestras raíces culturales y un entorno seguro donde cada estudiante crece con confianza.
      </p>
    </div>

    <!-- Cuadrícula Bento Asimétrica -->
    <div class="bento-grid">
      <!-- Tarjeta 1 (Bento Principal - Span 2 columnas) -->
      <article class="bento-card bento-card--lead" data-reveal>
        <div class="bento-card__lead-content">
          <span class="bento-badge bento-badge--accent">EQUIPO DOCENTE</span>
          <h3 class="bento-card__title bento-card__title--light">
            Instructores con experiencia en formación infantil y ritmos afro
          </h3>
          <p class="bento-card__text bento-card__text--light">
            Acompañamiento cercano en cada etapa. Corregimos postura, ritmo y coordinación con paciencia, respeto cultural y cero presión.
          </p>
          <div class="bento-stats">
            <div class="bento-stat-chip">
              <strong>14</strong>
              <span>Instructores</span>
            </div>
            <div class="bento-stat-chip">
              <strong>4 a 15</strong>
              <span>Años en 3 niveles</span>
            </div>
          </div>
        </div>
        <div class="bento-card__lead-visual">
          <Image
            src={photo6}
            alt="Instructores y bailarines en presentación escénica en Limón"
            class="bento-lead-img"
            widths={[400, 600]}
            sizes="(max-width: 768px) 90vw, 30vw"
            loading="lazy"
          />
        </div>
      </article>

      <!-- Tarjeta 2 (Espacio y Tarima - Span 1 columna) -->
      <article class="bento-card bento-card--light" data-reveal>
        <div class="bento-card__media">
          <Image
            src={photo12}
            alt="Salto en tarima de madera acondicionada para amortiguar el impacto"
            class="bento-card-img"
            widths={[380, 520]}
            sizes="(max-width: 768px) 90vw, 25vw"
            loading="lazy"
          />
        </div>
        <div class="bento-card__body">
          <span class="bento-badge">SEGURIDAD FÍSICA</span>
          <h3 class="bento-card__title">Piso acondicionado para danza</h3>
          <p class="bento-card__text">
            Tarima de madera diseñada para amortiguar caídas y proteger las articulaciones y rodillas al bailar.
          </p>
        </div>
      </article>

      <!-- Tarjeta 3 (Escenario Real - Span 1 columna) -->
      <article class="bento-card bento-card--light" data-reveal>
        <div class="bento-card__media">
          <Image
            src={photo10}
            alt="Coreografía teatral con luces y maquillaje tradicional"
            class="bento-card-img"
            widths={[380, 520]}
            sizes="(max-width: 768px) 90vw, 25vw"
            loading="lazy"
          />
        </div>
        <div class="bento-card__body">
          <span class="bento-badge">AUTOCONFIANZA</span>
          <h3 class="bento-card__title">Muestras trimestrales con público</h3>
          <p class="bento-card__text">
            Presentaciones en teatros reales con vestuarios y luces, para que bailen con orgullo y seguridad frente a sus familias.
          </p>
        </div>
      </article>

      <!-- Tarjeta 4 (Horarios y Familias - Span 2 columnas) -->
      <article class="bento-card bento-card--accent" data-reveal>
        <div class="bento-card__lead-visual">
          <Image
            src={photo1}
            alt="Estudiante sonriendo con trenzas y corona tradicional"
            class="bento-lead-img"
            widths={[400, 600]}
            sizes="(max-width: 768px) 90vw, 30vw"
            loading="lazy"
          />
        </div>
        <div class="bento-card__lead-content">
          <span class="bento-badge">ORGANIZACIÓN FAMILIAR</span>
          <h3 class="bento-card__title">
            Horarios claros y grupos organizados por edad
          </h3>
          <p class="bento-card__text">
            Turnos entre semana por la tarde (desde las 3:30 p.m.) y sábados durante la mañana (desde 8:30 a.m.), pensados para conciliar con la escuela sin estrés familiar.
          </p>
          <ul class="bento-feature-list" role="list">
            <li>
              <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Grupos pequeños para atención personalizada</span>
            </li>
            <li>
              <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Comunicación directa y transparente con tutores</span>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </div>

  <!-- Borde rasgado inferior conectado con el ticker oscuro -->
  <TornEdge color="#080302" edge="bottom" shadow={true} />
</section>

<style>
  .why-us {
    position: relative;
    padding-block-start: clamp(5rem, 4rem + 4vw, 7.5rem);
    padding-block-end: clamp(6.5rem, 5rem + 5vw, 9.5rem);
    background: #ffffff;
    color: var(--earth-900);
  }

  .why-us__container {
    max-inline-size: 74rem;
    margin-inline: auto;
  }

  /* Encabezado */
  .why-us__head {
    max-inline-size: 46rem;
    margin-block-end: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .why-us__kicker {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--ochre-700);
    text-transform: uppercase;
    margin-block-end: 0.75rem;
  }

  .why-us__title {
    font-size: clamp(2.2rem, 1.8rem + 2.4vw, 3.75rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--earth-900);
    text-transform: uppercase;
    margin-block-end: 1rem;
  }

  .why-us__subtitle {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: oklch(0.36 0.085 56 / 0.82);
    line-height: 1.6;
    margin: 0;
  }

  /* Cuadrícula Bento Moderna */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 54rem) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Tarjetas Bento */
  .bento-card {
    border-radius: 1.5rem;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid oklch(0.26 0.06 56 / 0.1);
    box-shadow: 0 4px 20px -4px oklch(0.26 0.06 56 / 0.06);
    transition: box-shadow 260ms ease, border-color 260ms ease;
  }

  .bento-card:hover {
    box-shadow: 0 12px 32px -6px oklch(0.26 0.06 56 / 0.12);
    border-color: oklch(0.66 0.18 50 / 0.35);
  }

  /* Bento Lead (Tarjeta oscura dominante) */
  .bento-card--lead {
    background: var(--earth-900);
    color: var(--cream-50);
    border-color: oklch(0.985 0.01 85 / 0.1);
  }

  @media (min-width: 54rem) {
    .bento-card--lead {
      grid-column: span 2;
      flex-direction: row;
      align-items: stretch;
    }
  }

  .bento-card__lead-content {
    flex: 1;
    padding: clamp(1.75rem, 1.5rem + 1.5vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .bento-card__lead-visual {
    flex: 0 0 42%;
    position: relative;
    min-height: 16rem;
    background: #190c05;
    overflow: hidden;
  }

  .bento-lead-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  /* Bento Light (Tarjetas blancas limpias) */
  .bento-card--light {
    background: #ffffff;
    color: var(--earth-900);
  }

  .bento-card__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f0e6d6;
  }

  .bento-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  .bento-card__body {
    padding: 1.5rem 1.65rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Bento Accent (Tarjeta complementaria crema / ocre) */
  .bento-card--accent {
    background: var(--cream-100);
    color: var(--earth-900);
    border-color: oklch(0.66 0.18 50 / 0.2);
  }

  @media (min-width: 54rem) {
    .bento-card--accent {
      grid-column: span 2;
      flex-direction: row-reverse;
      align-items: stretch;
    }
  }

  /* Tipografía y Badges de Bento */
  .bento-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: oklch(0.66 0.18 50 / 0.12);
    color: var(--ochre-700);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-block-end: 0.85rem;
  }

  .bento-badge--accent {
    background: oklch(0.88 0.11 82 / 0.2);
    color: var(--sun-300);
  }

  .bento-card__title {
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.45rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-block-end: 0.65rem;
  }

  .bento-card__title--light {
    color: #ffffff;
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.85rem);
    line-height: 1.2;
  }

  .bento-card__text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: oklch(0.36 0.085 56 / 0.85);
    margin: 0;
  }

  .bento-card__text--light {
    color: var(--cream-200);
    margin-block-end: 1.5rem;
  }

  /* Chips estadísticos dentro del Bento Principal */
  .bento-stats {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .bento-stat-chip {
    display: flex;
    flex-direction: column;
    padding: 0.65rem 1rem;
    background: oklch(0.19 0.035 58 / 0.5);
    border: 1px solid oklch(0.985 0.01 85 / 0.15);
    border-radius: 0.85rem;
  }

  .bento-stat-chip strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--sun-300);
    line-height: 1;
  }

  .bento-stat-chip span {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--cream-200);
    margin-top: 0.2rem;
    letter-spacing: 0.02em;
  }

  /* Lista de características */
  .bento-feature-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .bento-feature-list li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--earth-900);
  }

  .bento-feature-list svg {
    color: var(--ochre-600);
    flex-shrink: 0;
  }
</style>
