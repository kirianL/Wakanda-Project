---
/**
 * Pie de Página (Footer)
 * Identidad de marca en blanco sobre fondo tierra, enlaces de navegación,
 * datos de contacto y copyright.
 */
import { Image } from 'astro:assets';
import logoWhite from '@/assets/brand/logo-stacked-white.png';
import { site, nav } from '@/data/content';
---

<footer class="site-footer" data-surface="ink">
  <div class="container site-footer__container">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <a href="#inicio" aria-label="Wakanda Project, inicio">
          <Image src={logoWhite} alt="" width={220} />
        </a>
        <p class="site-footer__desc">
          Formando a la niñez a través de la danza afro y urbana. Espacio seguro de identidad, confianza y comunidad.
        </p>
      </div>

      <nav class="site-footer__nav" aria-label="Navegación pie de página">
        <span class="label site-footer__col-title">Explorar</span>
        <ul role="list">
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="#inscripcion">Inscripciones</a></li>
        </ul>
      </nav>

      <div class="site-footer__contact">
        <span class="label site-footer__col-title">Contacto</span>
        <p><strong>Ubicación:</strong> {site.location}</p>
        <p><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><strong>Instagram:</strong> <a href={site.instagram} target="_blank" rel="noopener noreferrer">@wakandaproject</a></p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</p>
      <p class="site-footer__quote">“Un niño inculcado en su cultura nunca olvidará sus raíces.”</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block-start: var(--space-8);
    padding-block-end: max(var(--space-8), calc(var(--space-6) + env(safe-area-inset-bottom, 0px)));
    background: var(--color-bg-ink-deep);
    color: var(--color-text-on-ink);
    border-block-start: 4px solid var(--color-bg-accent);
  }

  .site-footer__container {
    display: grid;
    gap: var(--space-8);
  }

  .site-footer__main {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 52rem) {
    .site-footer__main {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-4);
    max-inline-size: 32ch;
  }

  .site-footer__brand a {
    display: inline-block;
  }

  .site-footer__desc {
    font-size: var(--text-body-sm);
    color: var(--color-text-on-ink-muted);
    line-height: 1.5;
  }

  .site-footer__col-title {
    color: var(--color-text-accent-on-ink);
    display: block;
    margin-block-end: var(--space-4);
  }

  .site-footer__nav ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__nav a {
    text-decoration: none;
    color: var(--color-text-on-ink-muted);
    transition: color var(--duration-fast);
  }

  @media (hover: hover) {
    .site-footer__nav a:hover {
      color: var(--color-text-accent-on-ink);
    }
  }

  .site-footer__contact {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-body-sm);
    color: var(--color-text-on-ink-muted);
  }

  .site-footer__contact a {
    color: var(--color-text-on-ink);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid oklch(1 0 0 / 0.1);
    font-size: var(--text-label);
    color: var(--color-text-on-ink-muted);
  }

  .site-footer__quote {
    font-style: italic;
    color: var(--color-text-accent-on-ink);
  }
</style>
