---
/**
 * Botón-enlace de la marca.
 * - `solid`: la acción principal de la vista (solo una por sección).
 * - `ghost`: acciones secundarias.
 * `onInk` adapta los colores cuando el fondo es oscuro.
 */
interface Props {
  href: string;
  variant?: 'solid' | 'ghost';
  onInk?: boolean;
  static?: boolean;
  class?: string;
}

const { href, variant = 'solid', onInk = false, static: isStatic = false, class: className } = Astro.props;
---

<a href={href} class:list={['button', `button--${variant}`, { 'button--on-ink': onInk, 'button--static': isStatic }, className]}>
  <span><slot /></span>
  <svg class="button__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .button {
    --btn-bg: var(--color-action-solid);
    --btn-bg-hover: var(--color-action-solid-hover);
    --btn-fg: var(--color-action-on-solid);

    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: 3.25rem;
    padding-block: var(--space-3);
    padding-inline: var(--space-5) var(--space-4);
    border: 2px solid var(--btn-bg);
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 800;
    font-stretch: 110;
    line-height: 1.1;
    text-decoration: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition-property: background-color, border-color, color, transform;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .button--on-ink {
    --btn-bg: var(--color-action-solid-on-ink);
    --btn-bg-hover: var(--color-action-solid-on-ink-hover);
    --btn-fg: var(--color-action-on-solid-on-ink);
  }

  .button--ghost {
    background: transparent;
    color: var(--btn-bg);
  }

  .button__arrow {
    inline-size: 1.25rem;
    flex-shrink: 0;
    transition: transform var(--duration-base) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .button:hover {
      background: var(--btn-bg-hover);
      border-color: var(--btn-bg-hover);
    }

    .button--ghost:hover {
      background: var(--btn-bg);
      border-color: var(--btn-bg);
      color: var(--btn-fg);
    }

    .button:hover .button__arrow {
      transform: translateX(0.25rem);
    }
  }

  .button:not(.button--static):active {
    transform: scale(0.96);
    transition-duration: var(--duration-press);
  }
</style>
